{
  "manifest_version": 3,
  "name": "ValueTrace",
  "version": "0.1.24",
  "description": "See which API a number comes from. Click a number to start.",
  "permissions": ["scripting", "activeTab", "clipboardWrite", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ValueTrace",
    "default_popup": "popup.html"
  }
}
